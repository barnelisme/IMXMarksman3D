  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1670745405}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The software consists of five categories, namely; Login, Calibration,
    Main Menu, Training Settings, and Scenario. \r\n\r\na. LOGIN: login page is the
    access point of the system. In order to have access to the software you are required
    to enter your designated Imagistix email address and password.\r\n\nb. CALIBRATION:
    The calibration scene is fully autonomous, it is the highest requirement for
    the system to function fully. On this stage, you should ensure that the camera
    is pointed directly at the projected screen, note that the optimal position for
    the camera is the center of the screen. If not possible, then the ACC procedure
    will be required. Do not disturb calibration until it is complete.\r\n\nc. MAIN
    MENU: This is the control center of the system. On this scene you get access
    to all system settings, list of scenarios and control buttons.\r\n\nd. TRAINING
    SETTINGS: This page allows you to set and control all the requirements of the
    selected training scenario. You can set the total time, number of targets, number
    of magazines, and total ammunition required to be used in the training.\n\r\ne.
    SCENARIO: This is the running visual representation of the scene you selected
    in the main menu. It is what the trainee will interact with during training.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
