      m_Calls: []
  m_text: "Below are the directories you need to know for all navigation functionalities
    available in the system, these are the keyboard commands you need: \r\n\nLeft
    Shift + Escape = Back to main menu \r\nLeft Shift + Plus = Increment the shot
    delay \r\nLeft Shift + Minus = Decrement the shoot delay \r\nLeft Shift + Back
    = Erase data on the indoor training score board \r\nLeft Shift + Space = Restart
    Scene \r\nLeft Shift + R = Reset paper shots and paper roll\r\nLeft Shift + F1
    = register top left corner calibration point \r\nLeft Shift + F2 = register bottom
    right calibration point \r\nLeft Shift + F3 = calibration point\r\nUp button
    = Zoom In\r\nDown Button = Zoom Out\r\nLeft Button = Move left\r\nRight Button
    = Move right\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
